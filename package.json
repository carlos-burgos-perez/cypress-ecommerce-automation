{
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cypress": "^15.16.0",
    "eslint": "^10.4.1",
    "eslint-plugin-cypress": "^6.4.1",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2"
  },
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test": "cypress run",
    "lint": "eslint .",

    "report:merge": "mochawesome-merge reports/mocha/*.json > reports/report.json",
    "report:generate": "marge reports/report.json --reportDir reports --reportFilename report",
    "report": "npm run report:merge && npm run report:generate",
    "clean:reports": "rmdir /s /q reports"
  }
}
